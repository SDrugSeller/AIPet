{
  "name": "aipet",
  "version": "0.1.3",
  "description": "화면 위에 떠다니는 AI 에이전트 연동 데스크톱 펫",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test --test-timeout=30000",
    "pack": "electron-builder --dir",
    "dist": "node tools/dist.mjs",
    "dist:release": "node tools/dist.mjs release",
    "dist:debug": "node tools/dist.mjs debug"
  },
  "author": "AIPet",
  "build": {
    "appId": "com.aipet.app",
    "productName": "AIPet",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "package.json",
      "src/**/*",
      "personas/**/*",
      "skins/skin.schema.json",
      "skins/default/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AIPet-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0"
  }
}
